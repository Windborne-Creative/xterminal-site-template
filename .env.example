# Canonical public origin of this marketing site (sitemap, robots, metadata).
NEXT_PUBLIC_SITE_URL=https://example-client-site.com

# xTerminal app origin used for admin login and signup links.
NEXT_PUBLIC_APP_BASE_URL=https://app.xterminal.dev

# Server-only contact proxy target. Browser forms POST same-origin to /api/contact.
XT_BACKEND_CONTACT_ENDPOINT=https://app.xterminal.dev/api/contact

# Optional remote media origin. Falls back to NEXT_PUBLIC_APP_BASE_URL.
NEXT_PUBLIC_MARKETING_ASSET_BASE_URL=https://app.xterminal.dev

# xTerminal public API origin for runtime reads (pages, blog, entities).
NEXT_PUBLIC_XT_API_BASE_URL=https://app.xterminal.dev

# Workspace slug sent as x-xt-tenant-slug on the contact proxy.
NEXT_PUBLIC_XT_TENANT_SLUG=your-tenant-slug

# Optional tenant public runtime key for blog and entity reads.
NEXT_PUBLIC_XT_PUBLIC_API_KEY=
